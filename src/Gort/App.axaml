<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gort.App"
             RequestedThemeVariant="Light">
             <!-- Tema claro fixo: o design usa superfícies claras com cores
                  explícitas; seguir o sistema (escuro) deixava textos
                  invisíveis (branco sobre claro). -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>